<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="8dp">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar_books"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp">

        <Spinner
            android:id="@+id/spinner_sort"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="排序方式" />

        <Button
            android:id="@+id/btn_sort_order"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="降序"
            android:textSize="13sp"
            android:minWidth="44dp" />

        <Button
            android:id="@+id/btn_import"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="导入电子书"
            android:textSize="12sp"
            android:minWidth="48dp"
            android:contentDescription="导入电子书" />

        <Button
            android:id="@+id/btn_get_books"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="获取电子书"
            android:textSize="12sp"
            android:minWidth="48dp" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="设置"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- File browser bar (visible during import) -->
    <LinearLayout
        android:id="@+id/toolbar_files"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_up_dir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/arrow_up_float"
            android:contentDescription="返回上级目录"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_current_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="start"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btn_back_shelf"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="返回书架"
            android:textSize="13sp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:textSize="16sp"
        android:visibility="gone"
        android:textColor="?android:attr/textColorSecondary"
        android:text="书架为空，点击导入电子书添加" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
